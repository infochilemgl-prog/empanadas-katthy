OPENAI_API_KEY=tu_api_key_de_openai_aqui
PORT=3001
PUBLIC_BASE_URL=http://localhost:3001

# Postgres. En Vercel, al crear la base desde Storage → Create Database → Postgres y conectarla
# al proyecto, Vercel inyecta POSTGRES_URL automáticamente (no hace falta cargarla a mano ahí).
# Para desarrollo local (o cualquier otro proveedor Postgres) usá DATABASE_URL, o definí
# POSTGRES_URL vos mismo con la connection string de tu Postgres local. El código soporta
# cualquiera de las dos (POSTGRES_URL tiene prioridad si están las dos).
POSTGRES_URL=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

GOOGLE_CLIENT_ID=tu_client_id_de_google_aqui
GOOGLE_CLIENT_SECRET=tu_client_secret_de_google_aqui
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/callback
TZ_RESTAURANTE=America/Montevideo
